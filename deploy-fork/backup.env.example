# Axistra Portal — backup environment configuration template.
# Copy this file to /etc/axistra/backup.env and chmod 600.
# Reference it from /opt/axistra/backup.sh via cron.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axistra_db
DB_USER=axistra
PGPASSWORD=replace_me_with_real_db_password

# Encryption key (treat as ultra-secret; store in a password manager too)
GPG_PASSPHRASE=replace_me_with_long_random_passphrase

# Local backup directory & retention
BACKUP_DIR=/var/backups/axistra
RETENTION_DAYS=14

# Optional offsite destination
#   s3://your-bucket/axistra-backups
#   rclone:cloudflare-r2:axistra-backups
UPLOAD_DESTINATION=
